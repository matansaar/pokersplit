# Connect the SAME PostgreSQL database to every deployment.
# Set this in Vercel Environment Variables; never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Alternatively use a Supabase server-side connection (leave DATABASE_URL unset).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
